rules_version = '2';

// Правила Firestore для тренажёра. Публикуются командой `npx firebase-tools deploy --only firestore`
// (или вставкой в Firebase → Firestore Database → Rules). Список почт в isAdmin() должен совпадать
// с adminEmails в assets/js/config.js.
//
// Пользователи входят через Google; id пользователя — uid Firebase. Каждый читает и пишет
// только свои данные, админ читает всё и меняет статусы отчётов.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['shsulaymonov2007@gmail.com'];
    }
    function owns(data) { return signedIn() && data.user_id == request.auth.uid; }
    function unchanged(fields) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.id == uid;
      allow delete: if isAdmin();
    }

    match /games/{id} {
      allow read: if owns(resource.data) || isAdmin();
      allow create: if owns(request.resource.data) && request.resource.data.id == id;
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if isAdmin();
    }

    // Сводка пользователя для «Статистики» в админ-панели.
    match /stats/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.user_id == uid;
    }

    match /reports/{id} {
      allow read: if owns(resource.data) || isAdmin();
      allow create: if owns(request.resource.data) && request.resource.data.status == 'new';
      allow update: if isAdmin() || (owns(resource.data) && unchanged(['status', 'admin_note', 'user_id']));
      allow delete: if isAdmin();
    }

    // Закладки, свои наборы и настройки режимов пользователя.
    match /userdata/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.user_id == uid;
    }

    // Наборы вопросов: читают все вошедшие, публикует админ.
    match /sets/{setId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chunks/{chunk} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Уведомления создаёт админ (смена статуса отчёта) или сам пользователь себе
    // (вопрос из его набора скрыт); пользователь отмечает их прочитанными.
    match /notifications/{id} {
      allow read: if owns(resource.data) || isAdmin();
      allow create: if isAdmin() || owns(request.resource.data);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (owns(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at', '_ts']));
    }
  }
}
